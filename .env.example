# Copy to .env to change these. Everything has a default, so no .env is
# needed to run docker compose up --build.

# Addresses the browser uses for the links between the two services' pages.
# Change them if you publish the services on other host ports or a domain.
CATALOGUE_PUBLIC_URL=http://localhost:8001
SHOWS_PUBLIC_URL=http://localhost:8002

# Local SQL Server passwords. Optional: docker-compose.yml has local-only
# defaults. Never put the Azure passwords here; those live only in GitHub
# Actions secrets. SQL Server needs 8+ characters from 3 of: upper, lower,
# digit, symbol. Avoid ' and $ (they break the SQL script and compose), and
# @ : / ? # % (the service passwords also go inside DATABASE_URL).
# db-init does not change the password of a login that already exists, so
# after changing these run: docker compose down -v (this deletes local data).
# MSSQL_SA_PASSWORD=
# CATALOGUE_DB_PASSWORD=
# SHOWS_DB_PASSWORD=

# Set in docker-compose.yml, listed here for reference:
# CATALOGUE_URL=http://catalogue:8000   (how shows calls the catalogue API)
# PORT=8000                             (port inside each container)
# DATABASE_URL=mssql://catalogue_app:...@sqlserver:1433/catalogue  (catalogue)
# DATA_DIR=/data                        (folder for the shows SQLite file)
